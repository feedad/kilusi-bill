# =====================================================================
# FreeRADIUS SQL Module Configuration for Kilusi Bill
# =====================================================================
# PostgreSQL configuration with custom queries for multi-NAS support
# =====================================================================

sql {
    # Database dialect
    dialect = "postgresql"

    # Driver MUST be set to use real SQL database (not null driver)
    driver = "rlm_sql_${dialect}"

    # Connection info - for Docker use container name
    server = "kilusi-postgres"
    port = 5432
    login = "kilusi_user"
    password = "kilusi17!"
    radius_db = "kilusi_bill"

    # PostgreSQL-specific settings
    postgresql {
        send_application_name = yes
    }

    # Connection pool settings
    pool {
        start = 2
        min = 1
        max = 20
        spare = 3
        uses = 100
        lifetime = 0
        idle_timeout = 60
        retry_delay = 1
        max_retries = 5
        spread = no
    }

    # Read clients (NAS) from database - MULTI-NAS SUPPORT
    read_clients = yes

    # Client/NAS table configuration
    client_table = "nas"

    # Custom client query to match our nas table schema
    # Our schema uses: id, nasname, shortname, type, secret, (no 'server' column)
    client_query = "SELECT id, nasname, shortname, type, secret, NULL as server FROM nas WHERE is_active = true"

    # Group membership attribute
    group_attribute = "SQL-Group"

    # Delete stale sessions on restart
    delete_stale_sessions = yes

    # SQL User-Name - for lookups
    sql_user_name = "%{User-Name}"

    # Table names (required by queries.conf)
    authcheck_table = "radcheck"
    authreply_table = "radreply"
    groupcheck_table = "radgroupcheck"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"

    acct_table1 = "radacct"
    acct_table2 = "radacct"

    postauth_table = "radpostauth"

    # Include the default queries for PostgreSQL
    $INCLUDE ${modconfdir}/sql/main/postgresql/queries.conf
}
