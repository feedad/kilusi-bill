// Helper function to format payment method for display
const formatPaymentMethod = async (paymentMethod) => {
    if (!paymentMethod) return '-';

    // If it's a bank code, try to get the bank name
    if (paymentMethod.startsWith('bank_')) {
        try {
            const bankId = paymentMethod.replace('bank_', '');

            // Try different settings keys - parse JSON if needed
            let paymentSettings = await getSetting('payment_settings');
            if (typeof paymentSettings === 'string') {
                try { paymentSettings = JSON.parse(paymentSettings); } catch(e) {}
            }

            if (!paymentSettings) {
                let settings = await getSetting('paymentGateway');
                if (typeof settings === 'string') {
                    try { settings = JSON.parse(settings); } catch(e) {}
                }
                paymentSettings = settings;
            }

            if (paymentSettings) {
                // Handle both bank_accounts and bankAccounts naming
                const bankAccounts = paymentSettings.bank_accounts || paymentSettings.bankAccounts || [];
                const bank = bankAccounts.find(b => b.id == bankId || b.id === bankId || String(b.id) === String(bankId));
                if (bank) {
                    return `${bank.bankName || bank.bank_name || 'Bank'} - ${bank.accountNumber || bank.account_number || ''}`;
                }
            }

            // Fallback for bank codes that can't be resolved
            logger.warn(`Could not resolve bank name for ID: ${bankId}`);
            return 'Transfer Bank';
        } catch (error) {
            logger.warn('Error resolving bank name:', error);
            return 'Transfer Bank';
        }
    }

    // For manual payments (cash, ewallet), get details
    if (paymentMethod.startsWith('ewallet_')) {
        return 'E-Wallet';
    }

    if (paymentMethod === 'cash') {
        return 'Tunai';
    }

    // For gateway payments, return as-is
    return paymentMethod;
};

