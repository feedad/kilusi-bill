# ===================================================================== 
# Development Archive (Local Only)
# =====================================================================
_dev-archive/
_dev/
.dev/

# ===================================================================== 
# Dependencies
# =====================================================================
node_modules/
backend/node_modules/
frontend/node_modules/
frontend/.next/
frontend/.cache/
backend/dist/
backend/build/

# =====================================================================
# Environment & Configuration
# =====================================================================
.env
.env.local
.env.*.local
.env.production
*.env
!.env.example
!.env.docker.example

# Database credentials
backend/.env
backend/.env.local
backend/.env.production

# =====================================================================
# Logs & Temporary Files
# =====================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs/*.log
backend/logs/**/*.log

# PM2 logs
.pm2/
pm2.log
*.pm2.log

# =====================================================================
# Database Files
# =====================================================================
*.sql.backup
*.sql.bak
backup_*.sql
*_backup_*.sql
full_backup_*.tar.gz
*.dump
*.sqlite
*.sqlite3
*.db

# Backend backups
backend/backups/**/*
!backend/backups/.gitkeep

# Keep these SQL files
!scripts/master-schema.sql
!scripts/database-init.sql
!backend/migrations/*.sql
!freeradius/config/radius-schema.sql

# Don't upload large database dumps
public.sql
functions.sql
view_def.sql
testing-data.sql
backup*.sql
import_log.txt

